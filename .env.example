# Copy to .env and uncomment what you need. Empty values count as unset.

# Host port, published on 127.0.0.1 only (see compose.yaml)
#HOST_PORT=8888

# Require "Authorization: Bearer <token>" (set this before exposing the port)
#RDAP_API_TOKEN=change-me

# Result cache: seconds (0 = off) and approximate memory in MiB
#RDAP_CACHE_TTL=300
#RDAP_CACHE_SIZE=256

# Outbound: proxies or source IPs (comma-separated, rotated per request)
#RDAP_PROXY=socks5h://user:pass@10.0.0.1:1080,socks5h://10.0.0.2:1080
#RDAP_BIND=203.0.113.10,203.0.113.11
#RDAP_MAX_PER_HOST=8

# CORS for browser clients, max queries per /batch
#RDAP_CORS=true
#RDAP_MAX_BATCH=100

#RUST_LOG=info
