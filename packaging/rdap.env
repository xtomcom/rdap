# Environment for the rdap API server (rdap.service).
# Every setting is optional; uncomment to change the default.
# Restart after editing: systemctl restart rdap

## API server

# Address and port to listen on. Use 0.0.0.0 or :: to accept remote clients,
# and set RDAP_API_TOKEN when you do.
#RDAP_LISTEN=127.0.0.1
#RDAP_PORT=8888

# Require `Authorization: Bearer <token>` on every endpoint except /healthz.
#RDAP_API_TOKEN=

# Seconds to cache query results (0 disables the cache).
#RDAP_CACHE_TTL=300

# Approximate memory budget of the result cache, in MiB.
#RDAP_CACHE_SIZE=256

# Send permissive CORS headers (for browser clients).
#RDAP_CORS=false

# Maximum queries per POST /batch request.
#RDAP_MAX_BATCH=100

## Outbound network

# Network interface to send queries from.
#RDAP_INTERFACE=eth1

# Source IP(s) to send queries from; comma-separate to rotate.
#RDAP_BIND=203.0.113.10,203.0.113.11

# Proxy URL(s): socks5://, socks5h://, http://, https://; comma-separate to rotate.
#RDAP_PROXY=socks5h://user:pass@10.0.0.1:1080

# Maximum concurrent requests per upstream RDAP server (default 8 with --serve).
#RDAP_MAX_PER_HOST=8

## Misc

# Extra command-line flags for options without an env var.
#RDAP_ARGS=--timeout 60 --no-referral

# Log level: error, warn, info, debug, trace.
#RUST_LOG=warn
